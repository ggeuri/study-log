# =========================
# OS / Editor
# =========================
.DS_Store
**/.DS_Store
Thumbs.db

# VSCode
.vscode/

# IntelliJ
.idea/
*.iml
out/

# Eclipse / STS
.project
.classpath
.settings/
.factorypath
**/.metadata/

# =========================
# Logs / Crash
# =========================
*.log
**/logs/
hs_err_pid*
replay_pid*

# =========================
# Java / Build outputs
# =========================
**/target/
**/build/
**/out/
**/*.class

# Maven/Gradle cache
.gradle/
**/.gradle/

# (선택) 산출물 제외(필요하면 주석 처리)
**/*.jar
**/*.war

# =========================
# Frontend (Node) - "전역 dist 금지" 피하기
# =========================
# ※ dist/build를 전역(**/dist/)으로 막으면 AdminLTE 같은 정적자원(dist 폴더명)까지 날아갑니다.
#    그래서 "프론트 폴더만" 지정해서 무시합니다.
front/**/node_modules/
front/**/dist/
front/**/build/
front/**/.cache/
front/**/.vite/
front/**/coverage/

# 프론트 폴더명이 다른 경우도 대비(원하시면 프로젝트 폴더명으로 바꿔드릴 수 있음)
**/node_modules/
**/.vite/
**/.cache/
**/coverage/

# =========================
# Secrets (중요)
# =========================
**/.env
**/.env.*
!**/.env.example

# Spring Boot config (비번/키 유출 방지)
**/application.yml
**/application.yaml
**/application-*.yml
**/application-*.yaml
!**/application-example.yml
!**/application-example.yaml

# Key / Cert
**/*.jks
**/*.p12
**/*.pem
**/*.key
**/*.crt

# =========================
# DB dump / local files
# =========================
**/*.sql
**/*.dump
**/*.sqlite
**/*.db

# =========================
# Project-specific: 템플릿 원본 zip는 레포 비대화 방지
# =========================
java/shop/src/main/webapp/resources/template/Source/*.zip