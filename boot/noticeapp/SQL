새로운 프로젝트에 사용할 데이터베이스 생성

1) mysql을 root로 접속
2) create database kiosk;
3) use kiosk;
4) 유저만들기
create user 'boot'@'%' identified by '1234';
grant all privileges on kiosk.* to 'boot'@'%'  with grant option;
flush privileges;

5) boot로 접속
6) use kiosk;
7) 공지게시판테이블 생성

USE kiosk;

CREATE TABLE notice(
notice_id bigint PRIMARY KEY AUTO_INCREMENT
, title varchar(100)
, writer varchar(20)
, content text
, regdate datetime DEFAULT CURRENT_TIMESTAMP()
) DEFAULT CHARACTER SET CHARSET=utf8mb4;
