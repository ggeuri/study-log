<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="TopCategory">

<resultMap type="TopCategory" id="subCategoryMap">
<id column="topcategory_id" property="topcategory_id"/>
<id column="topname" property="topname"/>
<!-- 자식 수집해서 subList 멤버변수에 채우기 -->
<collection 
column="topcategory_id" 
select="SubCategory.selectByTopCategoryId"
property="subList"
javaType="java.util.List"
ofType="SubCategory"/>

</resultMap>


<!-- 현재로써는 아래의 쿼리에 의해 pk와 topname만을 채울 수 있으므로 하나의 상위 카테고리에 소속된 자식인 하위 카테고리목록을 마이바티스가 자동으로 매핑못함
subCategory는 개발자가 직접 resultMap통해서 매핑 시도해야함  -->
<select id="selectAll" resultMap = "subCategoryMap" >
select topcategory_id, topname from topcategory
</select>

</mapper>